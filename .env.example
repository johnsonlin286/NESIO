# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# HTTP & keamanan
# ---------------------------------------------------------------------------
# Origin yang boleh connect, pisahkan dengan koma. WAJIB di production.
# React Native tidak mengirim header Origin, jadi tetap bisa connect.
CORS_ORIGIN=http://localhost:3001,http://localhost:5173
# Isi 1 jika di belakang reverse proxy / load balancer (nginx, Railway, Render, dll)
TRUST_PROXY=0
# Rate limit REST API: RATE_LIMIT_MAX request per RATE_LIMIT_WINDOW_MS per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# Auth: "guest" (tanpa login) atau "jwt"
# ---------------------------------------------------------------------------
AUTH_MODE=guest
# Mode guest: rahasia untuk menandatangani session token (min 32 karakter). WAJIB di production.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Mode jwt: isi salah satu
# JWT_SECRET=shared-secret-HS256-minimal-32-karakter
# JWT_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
# JWT_ISSUER=
# JWT_AUDIENCE=

# ---------------------------------------------------------------------------
# Socket.IO
# ---------------------------------------------------------------------------
SOCKET_MAX_PAYLOAD_BYTES=102400
# Maksimal event per koneksi per window
SOCKET_RATE_LIMIT_MAX=30
SOCKET_RATE_LIMIT_WINDOW_MS=1000

# ---------------------------------------------------------------------------
# Room
# ---------------------------------------------------------------------------
# Lama menunggu user reconnect sebelum dikeluarkan dari room
RECONNECT_GRACE_MS=30000
# Room tanpa aktivitas selama ini akan ditutup
ROOM_IDLE_TTL_MS=1800000
ROOM_SWEEP_INTERVAL_MS=60000
ROOM_DEFAULT_MAX_MEMBERS=8
ROOM_MAX_MEMBERS_LIMIT=50
# migrate = host pindah ke member paling lama | close = room ditutup
HOST_LEAVE_POLICY=migrate
